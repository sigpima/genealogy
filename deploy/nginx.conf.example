# nginx trên host (không trong Docker) là cổng ra Internet cho gia phả. Chuẩn: ~/.claude/CLAUDE.md, mục "Triển khai".
# Cài: copy thành /etc/nginx/sites-available/gia-pha (hoặc conf.d/gia-pha.conf), đổi gia-pha.example.com cho đúng, rồi:
#   sudo certbot certonly --nginx -d gia-pha.example.com      # lấy chứng chỉ TLS lần đầu (cần khối :80 bên dưới đã chạy)
#   sudo nginx -t && sudo systemctl reload nginx
# .env trên server phải khớp: FRONTEND_ORIGIN=https://gia-pha.example.com, COOKIE_SECURE=true, TRUSTED_PROXY_HOPS=1.
# Cổng 34020 là cổng host của service web (docker-compose.prod.yml, bind 127.0.0.1).

# Giới hạn tần suất cho endpoint tốn tài nguyên (dựng quyển phả PDF, xuất toàn bộ dữ liệu). Giới hạn đăng nhập/quên mật khẩu
# do chính API lo (cần TRUSTED_PROXY_HOPS=1 để thấy địa chỉ thật), không lặp lại ở đây.
limit_req_zone $binary_remote_addr zone=gia_pha_heavy:10m rate=6r/m;

server {
    listen 80;
    listen [::]:80;
    server_name gia-pha.example.com;

    # certbot --nginx / --webroot dùng khối này để xác thực; còn lại chuyển sang HTTPS.
    location / { return 301 https://$host$request_uri; }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name gia-pha.example.com;

    ssl_certificate     /etc/letsencrypt/live/gia-pha.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/gia-pha.example.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;

    # HSTS thuộc về nơi kết thúc HTTPS (API/web cố ý không gửi). Chỉ bật khi chắc chắn HTTPS chạy ổn.
    add_header Strict-Transport-Security "max-age=31536000" always;

    server_tokens off;
    client_max_body_size 25m;          # ảnh/tài liệu tải lên (app giới hạn 10 MB/file, nhập CSV 5 MB)
    proxy_read_timeout 300s;           # quyển phả PDF của họ lớn soạn lâu (khớp experimental.proxyTimeout của web)
    proxy_send_timeout 300s;

    # Dùng chung cho mọi location bên dưới (kế thừa vì không location nào đặt proxy_set_header riêng).
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $remote_addr;   # GHI ĐÈ, không nối thêm ($proxy_add_x_forwarded_for): để API tin được địa chỉ này
    proxy_set_header X-Forwarded-Proto $scheme;

    # Swagger/OpenAPI của API không cần phơi ra Internet (web proxy /api/* sang API nên nó tới được từ ngoài).
    location ~ ^/api/(docs|redoc|openapi\.json) { return 404; }

    location = /api/book.pdf {
        limit_req zone=gia_pha_heavy burst=3 nodelay;
        limit_req_status 429;
        proxy_pass http://127.0.0.1:34020;
    }

    location ~ ^/api/export/ {
        limit_req zone=gia_pha_heavy burst=3 nodelay;
        limit_req_status 429;
        proxy_pass http://127.0.0.1:34020;
    }

    location / {
        proxy_pass http://127.0.0.1:34020;
    }
}
