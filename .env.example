# Biến cho ../docker-compose.yml (root). Copy thành .env rồi điền giá trị thật;
# KHÔNG commit file .env. Ba biến đánh dấu (bắt buộc) mà thiếu thì
# `docker compose` báo lỗi ngay thay vì chạy với mật khẩu mặc định.

# --- Postgres ---------------------------------------------------------------
POSTGRES_USER=genealogy
# (bắt buộc) Dùng ký tự nào cũng được (@ : / # ? ...). Nếu mật khẩu có $, #,
# dấu nháy hoặc khoảng trắng thì bọc trong nháy đơn: POSTGRES_PASSWORD='abc$#x'
POSTGRES_PASSWORD=
POSTGRES_DB=genealogy

# --- API --------------------------------------------------------------------
# (bắt buộc) Chuỗi ngẫu nhiên đủ dài để ký JWT, vd: openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRE_MINUTES=60

# Origin mà browser thật sự dùng để mở web. Đứng sau reverse proxy HTTPS thì
# đặt https://<domain> và COOKIE_SECURE=true.
FRONTEND_ORIGIN=http://localhost:3000
COOKIE_SECURE=false

# SMTP chỉ cần cho email quên mật khẩu. Để trống thì API vẫn trả 200 nhưng
# không gửi mail thật.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true

# --- Bảo mật ----------------------------------------------------------------
# Giới hạn tần suất đăng nhập/đăng ký/quên mật khẩu/trả lời thiệp (mặc định bật).
# RATE_LIMIT_ENABLED=true
# Số proxy tin cậy phía trước web (nginx/Caddy). 0 = không tin X-Forwarded-For (mặc định).
# Đặt 1 khi có reverse proxy ghi đè X-Forwarded-For; xem DOCKER.md "Bảo mật & vận hành".
# TRUSTED_PROXY_HOPS=0

# --- Frontend ---------------------------------------------------------------
# Chỉ frontend publish port ra máy chủ. Mặc định nghe 0.0.0.0 (mở được từ máy
# khác, vd khi ssh vào máy này). Trên server thật đứng sau reverse proxy thì đặt
# FRONTEND_BIND=127.0.0.1 để chỉ proxy gọi được.
FRONTEND_BIND=0.0.0.0
FRONTEND_PORT=3000

# --- Tuỳ chọn ---------------------------------------------------------------
# Tên/tag image — dùng khi CI build + push lên registry (rồi `docker compose
# pull`). Để trống thì build tại chỗ và gắn tên genealogy-api / genealogy-web.
# API_IMAGE=ghcr.io/<org>/genealogy-api
# API_IMAGE_TAG=latest
# WEB_IMAGE=ghcr.io/<org>/genealogy-web
# WEB_IMAGE_TAG=latest

# MTU của network Docker (mặc định 1500) — xem ghi chú ở cuối docker-compose.yml.
# DOCKER_NETWORK_MTU=1492
